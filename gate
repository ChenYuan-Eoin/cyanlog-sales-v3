#!/bin/bash
#
# gate - ONES 模式 Gate 控制器
# 用法: ./gate [permissive|enforcing|G2|G4|status]
#

set -e

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
STATE_PATH="$PROJECT_ROOT/governance/runtime-state/harness-state.json"

function show_help() {
    echo "ONES Gate Controller - 代码质量门控"
    echo ""
    echo "用法:"
    echo "  ./gate permissive   - 宽松模式（默认，不拦截）"
    echo "  ./gate enforcing    - 强制模式（激活 gates）"
    echo "  ./gate G2           - 审查门（只读工具）"
    echo "  ./gate G4           - 复核门（深度分析）"
    echo "  ./gate status       - 查看当前状态"
    echo "  ./gate help         - 显示帮助"
    echo ""
    echo "当前状态:"
    show_status
}

function show_status() {
    if [ -f "$STATE_PATH" ]; then
        # 使用 Python 解析 JSON
        python3 -c "
import json
import sys
try:
    with open('$STATE_PATH', 'r') as f:
        data = json.load(f)
    print(f\"  模式: {data.get('mode', 'unknown')}\")
    print(f\"  状态: {data.get('status', 'unknown')}\")
    gates = data.get('activeGates', [])
    print(f\"  激活 Gates: {', '.join(gates) if gates else '无'}\")
except Exception as e:
    print(f\"  错误: {e}\")
    sys.exit(1)
"
    else
        echo "  状态文件不存在，创建默认状态..."
        set_permissive
    fi
}

function set_permissive() {
    cat > "$STATE_PATH" << 'JSON'
{
  "version": "1.0",
  "status": "permissive",
  "mode": "permissive",
  "startedAt": "2026-06-11T00:00:00Z",
  "configPath": "governance/runtime-config-AI运行配置/config-配置文件/settings-claude运行配置.json",
  "activeHooks": ["UserPromptSubmit", "PreToolUse", "SessionEnd"],
  "activeGates": [],
  "lastActivity": "2026-06-11T00:00:00Z"
}
JSON
    echo "✅ 已切换到宽松模式 (permissive)"
    echo "   所有工具 unrestricted"
}

function set_enforcing() {
    cat > "$STATE_PATH" << 'JSON'
{
  "version": "1.0",
  "status": "strict",
  "mode": "enforcing",
  "startedAt": "2026-06-11T00:00:00Z",
  "configPath": "governance/runtime-config-AI运行配置/config-配置文件/settings-claude运行配置.json",
  "activeHooks": ["UserPromptSubmit", "PreToolUse", "SessionEnd"],
  "activeGates": ["G2"],
  "lastActivity": "2026-06-11T00:00:00Z"
}
JSON
    echo "✅ 已切换到强制模式 (enforcing)"
    echo "   激活 Gate: G2 (审查门)"
}

function set_g2() {
    cat > "$STATE_PATH" << 'JSON'
{
  "version": "1.0",
  "status": "strict",
  "mode": "enforcing",
  "startedAt": "2026-06-11T00:00:00Z",
  "configPath": "governance/runtime-config-AI运行配置/config-配置文件/settings-claude运行配置.json",
  "activeHooks": ["UserPromptSubmit", "PreToolUse", "SessionEnd"],
  "activeGates": ["G2"],
  "gates": {
    "G2": {
      "description": "审查门 - 严格只读，禁止编辑",
      "enforced": true,
      "tools": ["Read", "Grep", "Glob", "Bash"],
      "blockedTools": ["Edit", "Write", "NotebookEdit"]
    }
  },
  "lastActivity": "2026-06-11T00:00:00Z"
}
JSON
    echo "✅ 已激活 G2 审查门"
    echo "   允许: Read, Grep, Glob, Bash"
    echo "   禁止: Edit, Write, NotebookEdit"
}

function set_g4() {
    cat > "$STATE_PATH" << 'JSON'
{
  "version": "1.0",
  "status": "strict",
  "mode": "enforcing",
  "startedAt": "2026-06-11T00:00:00Z",
  "configPath": "governance/runtime-config-AI运行配置/config-配置文件/settings-claude运行配置.json",
  "activeHooks": ["UserPromptSubmit", "PreToolUse", "SessionEnd"],
  "activeGates": ["G4"],
  "gates": {
    "G4": {
      "description": "复核门 - 只读+深度分析",
      "enforced": true,
      "tools": ["Read", "Grep", "Glob"],
      "blockedTools": ["Edit", "Write", "NotebookEdit", "Bash"]
    }
  },
  "lastActivity": "2026-06-11T00:00:00Z"
}
JSON
    echo "✅ 已激活 G4 复核门"
    echo "   允许: Read, Grep, Glob"
    echo "   禁止: Edit, Write, NotebookEdit, Bash"
}

# 主逻辑
case "${1:-status}" in
    permissive|p)
        set_permissive
        ;;
    enforcing|e)
        set_enforcing
        ;;
    G2|g2)
        set_g2
        ;;
    G4|g4)
        set_g4
        ;;
    status|s|"")
        echo "当前 Gate 状态:"
        show_status
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "❌ 未知命令: $1"
        echo ""
        show_help
        exit 1
        ;;
esac
