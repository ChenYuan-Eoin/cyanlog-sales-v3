# Workspace-level local environment reference
#
# Active app template:
#   cyanlog-sales-v3/.env.example
#
# This file keeps the root workspace docs/scripts aligned with the current
# local infrastructure defaults in docker-compose.yml.

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Supabase Auth (minimal local chain via Kong)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-key

# Authentication / app secrets
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-string-min-32-chars
JWT_SECRET=change-this-to-another-random-string-min-32-chars
APP_SECRET=replace-with-32-plus-char-secret
ENCRYPTION_KEY=replace-with-32-byte-key

# Local model (OpenAI-compatible endpoint)
LOCAL_MODEL_URL=http://localhost:1234/v1
LOCAL_MODEL_NAME=local-model
AI_TIMEOUT=120000

# Optional cloud providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Feature flags / debug
LOG_LEVEL=debug
NEXT_PUBLIC_REACT_QUERY_DEVTOOLS=true
NEXT_PUBLIC_ENABLE_AI_REVIEW=true
NEXT_PUBLIC_ENABLE_CONTRACT_EXPORT=true
NEXT_PUBLIC_ENABLE_BID_MANAGEMENT=false
