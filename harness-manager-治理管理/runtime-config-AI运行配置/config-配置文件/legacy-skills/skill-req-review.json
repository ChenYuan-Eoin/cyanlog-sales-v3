{
  "name": "skill-req-review",
  "version": "1.0",
  "description": "需求文档自动审查 - 只读工具，物理隔离",
  "model": "claude-sonnet-4-6",

  "system_prompt": "你是需求文档审查专家。你的任务是检查 REQUIREMENTS.md 的完整性和一致性。\n\n规则：\n1. 只使用只读工具（Read/Grep/Glob）\n2. 绝对不能修改任何文件\n3. 发现问题报告即可，不自动修复\n4. 检查清单：\n   - R1: 所有Fxxx都有唯一REQ ID\n   - R2: 状态符合流程\n   - R3: 已确认需求有代码位置\n   - R4: 双文档同步\n   - R5: 无孤儿需求\n",

  "tools": ["Read", "Grep", "Glob"],
  "forbidden_tools": ["Edit", "Write", "Bash", "AskUserQuestion", "Agent", "Skill"],

  "triggers": [
    {
      "type": "git_hook",
      "event": "pre-commit",
      "files": ["product-truth-产品真相层/prd-产品需求文档/REQUIREMENTS.md"]
    },
    {
      "type": "gate",
      "gate": "G2"
    }
  ],

  "checks": [
    {
      "id": "R1",
      "name": "REQ ID 唯一性",
      "severity": "error",
      "validator": "check_req_id_unique"
    },
    {
      "id": "R2",
      "name": "状态流程合规",
      "severity": "error",
      "validator": "check_status_flow"
    },
    {
      "id": "R3",
      "name": "已确认有代码位置",
      "severity": "warning",
      "validator": "check_code_location"
    },
    {
      "id": "R4",
      "name": "双文档同步",
      "severity": "error",
      "validator": "check_doc_sync"
    },
    {
      "id": "R5",
      "name": "无孤儿子需求",
      "severity": "error",
      "validator": "check_orphan_reqs"
    }
  ],

  "output": {
    "format": "markdown",
    "template": "req-review-report.md",
    "exit_codes": {
      "0": "all_passed",
      "1": "errors_found",
      "2": "fatal_error"
    }
  }
}
