{
  "version": "1.0",
  "description": "Price V3 治理配置 - Harness + Hook + Skill",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/run_managed_hook.py",
              "claude-user-prompt-submit"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/run_managed_hook.py",
              "claude-pretool-req-confirmed"
            ]
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/run_managed_hook.py",
              "claude-pretool-req-id"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/run_managed_hook.py",
              "generate-changelog"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "skills": {
    "skill-socrates": {
      "description": "苏格拉底式提问 - 需求确认时触发",
      "trigger": {
        "type": "pattern",
        "pattern": "F[0-9]{3}.*(已确认|合并到主干)",
        "auto_run": true
      },
      "config": {
        "min_questions": 3,
        "max_questions": 5,
        "categories": [
          "technical",
          "risk",
          "alignment",
          "edge-case",
          "maintenance"
        ]
      }
    },
    "skill-req-review": {
      "description": "需求文档审查",
      "trigger": {
        "type": "git_hook",
        "event": "pre-commit",
        "files": [
          "product-truth-产品真相层/prd-产品需求文档/REQUIREMENTS.md"
        ]
      }
    }
  },
  "gates": {
    "G2": {
      "description": "审查门 - 只读工具",
      "tools": [
        "Read",
        "Grep",
        "Glob"
      ],
      "skills": [
        "skill-req-review",
        "skill-code-review"
      ]
    },
    "G4": {
      "description": "复核门 - 只读工具",
      "tools": [
        "Read",
        "Grep"
      ],
      "skills": [
        "skill-socrates"
      ]
    }
  }
}
