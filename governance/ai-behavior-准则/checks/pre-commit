#!/bin/bash
# pre-commit - Git pre-commit 钩子
# 运行所有 AI 行为硬约束检查
#
# 行为模式：
#   默认（交互环境）: 失败时询问用户是否继续
#   默认（CI/非交互）: 严格阻断
#   STRICT=1: 严格阻断（CI 推荐）
#   SOFT=1: 软失败（仅警告，不阻断）
#   SKIP_CHECKS=1: 完全跳过（紧急情况）
#
# 通过 git commit --no-verify 永远跳过

set -e

# 关键：所有 check 脚本都使用相对路径（如 product-truth/product-code/...）
# 必须先 cd 到 git 根目录，否则路径解析失败
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
if [ -n "$GIT_ROOT" ]; then
    cd "$GIT_ROOT"
fi

# 兼容 core.hooksPath 设置与直接调用两种方式
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# 检查脚本位置：如果在 .githooks/ 下，CHECKS_DIR 在 governance 中
if [ -d "$HOOK_DIR/checks" ]; then
    CHECKS_DIR="$HOOK_DIR/checks"
    PROJECT_ROOT="$(cd "$HOOK_DIR/.." && pwd)"
else
    # pre-commit 通过 core.hooksPath 指向 governance/.../checks 时
    CHECKS_DIR="$HOOK_DIR"
    PROJECT_ROOT="$(cd "$HOOK_DIR/../../.." && pwd)"
fi

# 跳过机制
if [ "${SKIP_CHECKS:-0}" = "1" ]; then
    echo "⚠️  SKIP_CHECKS=1，跳过所有 AI 行为检查"
    exit 0
fi

# ANSI 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔒 AI 行为硬约束检查 (10项)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 模式判断
IS_INTERACTIVE=false
[ -t 0 ] && IS_INTERACTIVE=true

if [ "${STRICT:-0}" = "1" ]; then
    MODE="strict"
elif [ "${SOFT:-0}" = "1" ]; then
    MODE="soft"
elif [ "$IS_INTERACTIVE" = "true" ]; then
    MODE="interactive"
else
    MODE="strict"  # CI / 非交互默认严格
fi

echo "模式: $MODE (interactive=$IS_INTERACTIVE, STRICT=${STRICT:-0}, SOFT=${SOFT:-0})"
echo ""

FAILED=0
PASSED=0
FAILURE_DETAILS=()

# 运行所有 check 脚本
for check in "$CHECKS_DIR"/check-*.sh; do
    if [ -f "$check" ]; then
        name=$(basename "$check" .sh | sed 's/check-[0-9]*-//' | tr '-' ' ')
        echo "▶️  运行: $name..."

        if bash "$check" 2>&1; then
            PASSED=$((PASSED + 1))
            echo -e "${GREEN}   ✅ 通过${NC}"
        else
            FAILED=$((FAILED + 1))
            FAILURE_DETAILS+=("$name")
            echo -e "${RED}   ❌ 失败${NC}"
        fi
        echo ""
    fi
done

# 记录审计日志
AUDIT_DIR="$PROJECT_ROOT/governance/ai-behavior-准则/audit"
mkdir -p "$AUDIT_DIR"

COMMIT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo "pre-commit")
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
LOG_ENTRY="{\"timestamp\":\"$TIMESTAMP\",\"commit\":\"$COMMIT_HASH\",\"passed\":$PASSED,\"failed\":$FAILED,\"mode\":\"$MODE\",\"trigger\":\"pre-commit\"}"

echo "$LOG_ENTRY" >> "$AUDIT_DIR/behavior-log.jsonl"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}✅ 通过: $PASSED${NC}  ${RED}❌ 失败: $FAILED${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# 决策
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}🎉 所有检查通过${NC}"

    # ONES 模式：收集反馈供 AI 参考
    if [ -f "$PROJECT_ROOT/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/feedback-collector.js" ]; then
        echo ""
        echo "📊 正在收集反馈数据..."
        node "$PROJECT_ROOT/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/feedback-collector.js" 2>/dev/null || true
    fi

    exit 0
fi

# 有失败
echo ""
echo -e "${RED}❌ 失败的检查项:${NC}"
for f in "${FAILURE_DETAILS[@]}"; do
    echo "   - $f"
done
echo ""

# ONES 模式：失败时自动触发 feedback
echo "📊 正在收集失败反馈..."
if [ -f "$PROJECT_ROOT/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/feedback-collector.js" ]; then
    node "$PROJECT_ROOT/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/feedback-collector.js" 2>/dev/null || true
fi
echo ""

case "$MODE" in
    soft)
        echo -e "${YELLOW}⚠️  SOFT 模式：仅警告，不阻断提交${NC}"
        exit 0
        ;;
    strict)
        echo -e "${RED}🚫 STRICT 模式：阻断提交${NC}"
        echo ""
        echo "跳过方法："
        echo "  • git commit --no-verify    （跳过 hook）"
        echo "  • SOFT=1 git commit        （软失败模式）"
        echo "  • SKIP_CHECKS=1 git commit （完全跳过）"
        exit 1
        ;;
    interactive)
        echo -n "是否继续提交? (y/N): "
        read -r response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo -e "${YELLOW}⚠️  继续提交（不推荐）${NC}"
            exit 0
        else
            echo "提交已取消"
            exit 1
        fi
        ;;
    *)
        exit 1
        ;;
esac
