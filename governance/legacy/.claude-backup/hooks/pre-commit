#!/bin/bash
# REQ:GOV-HOOK-001
# PURPOSE: Git pre-commit hook - 多维度治理检查
# 由 scripts/run_managed_hook.py 调用

set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNTIME_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
HOOKS_DIR="$SCRIPT_DIR"
VALIDATORS_DIR="$RUNTIME_DIR/validators-校验器"

echo "🔍 Running Price V3 pre-commit hooks..."
echo ""

ERRORS=0

# ============================================
# H001: 需求确认状态检查
# ============================================
echo "[H001] Checking requirement confirmation status..."

if [ -f "$HOOKS_DIR/check-req-confirmed.js" ]; then
    while IFS= read -r -d '' file; do
        if [ -f "$ROOT_DIR/$file" ]; then
            node "$HOOKS_DIR/check-req-confirmed.js" "$ROOT_DIR/$file" || ERRORS=$((ERRORS + 1))
        fi
    done < <(git diff --cached --name-only -z)
fi

# ============================================
# H002: REQ ID 追踪检查
# ============================================
echo "[H002] Checking REQ ID tracing..."

if [ -f "$HOOKS_DIR/check-req-id-in-code.js" ]; then
    while IFS= read -r -d '' file; do
        if [ -f "$ROOT_DIR/$file" ]; then
            node "$HOOKS_DIR/check-req-id-in-code.js" "$ROOT_DIR/$file" || ERRORS=$((ERRORS + 1))
        fi
    done < <(git diff --cached --name-only -z)
fi

# ============================================
# H003: 隔离检查
# ============================================
echo "[H003] Checking layer isolation..."

if [ -f "$HOOKS_DIR/check-import-isolation.js" ]; then
    while IFS= read -r -d '' file; do
        if [ -f "$ROOT_DIR/$file" ]; then
            node "$HOOKS_DIR/check-import-isolation.js" "$ROOT_DIR/$file" || ERRORS=$((ERRORS + 1))
        fi
    done < <(git diff --cached --name-only -z)
fi

# ============================================
# H006: 敏感信息检查
# ============================================
echo "[H006] Checking for sensitive information..."
if [ -f "$HOOKS_DIR/check-env-security.sh" ]; then
    "$HOOKS_DIR/check-env-security.sh" || ERRORS=$((ERRORS + 1))
fi

# ============================================
# H008: PRD 同步检查
# ============================================
if git diff --cached --name-only | grep -qE "REQUIREMENTS\.md|PRD-PRODUCT\.md"; then
    echo "[H008] Checking PRD synchronization..."
    if [ -f "$VALIDATORS_DIR/prd-sync-check.js" ]; then
        node "$VALIDATORS_DIR/prd-sync-check.js" || {
            echo "  ⚠️  PRD-PRODUCT.md may be out of sync with REQUIREMENTS.md"
        }
    fi
fi

# ============================================
# 结果输出
# ============================================
echo ""
if [ "$ERRORS" -eq 0 ]; then
    echo "✅ All pre-commit checks passed"
    exit 0
else
    echo "❌ Pre-commit checks failed: $ERRORS error(s)"
    echo ""
    echo "Fix the issues above before committing."
    echo "For emergency fixes: git commit --no-verify (not recommended)"
    exit 2
fi
