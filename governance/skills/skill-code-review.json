{
  "name": "skill-code-review",
  "version": "1.0",
  "description": "代码审查 - 检查代码规范和项目约束",
  "model": "claude-sonnet-4-6",

  "system_prompt": "你是代码审查专家。你的任务是检查代码是否符合项目规范。\n\n规则：\n1. 只使用只读工具（Read, Grep）\n2. 不修改代码\n3. 检查项：\n   - C1: 文件头包含 REQ ID 标记（// REQ:Fxxx）\n   - C2: 无 TODO/FIXME 遗留（警告级别）\n   - C3: 错误处理完整（try/catch 或返回值检查）\n   - C4: 命名规范（camelCase）\n4. 发现问题记录但不阻止（除非 severity=error）\n5. 生成审查报告\n",

  "tools": ["Read", "Grep"],
  "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash", "Agent", "Skill"],

  "triggers": [
    {
      "type": "git_hook",
      "event": "pre-commit",
      "files": [
        "product-truth/product-code/**/*.ts",
        "product-truth/product-code/**/*.tsx"
      ]
    }
  ],

  "checks": [
    {
      "id": "C1",
      "name": "REQ ID 标记",
      "pattern": "^//\\s*REQ:\\s*F\\d{3}",
      "severity": "error"
    },
    {
      "id": "C2",
      "name": "无 TODO/FIXME",
      "pattern": "TODO|FIXME",
      "severity": "warning",
      "invert": true
    },
    {
      "id": "C3",
      "name": "错误处理",
      "severity": "warning"
    },
    {
      "id": "C4",
      "name": "命名规范",
      "severity": "warning"
    }
  ],

  "output": {
    "format": "markdown",
    "template": "code-review-report.md"
  }
}
