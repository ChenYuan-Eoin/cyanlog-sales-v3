{
  "version": "1.0",
  "description": "Price V3 治理配置 - Harness + Hook + Skill",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/project-registry.js",
              "claude-user-prompt-submit"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/governance/runtime-config-AI运行配置/runtime-code-运行代码/hooks-钩子/claude-pretool-gate-enforcer.js"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/governance/runtime-config-AI运行配置/runtime-code-运行代码/scripts-脚本/project-registry.js",
              "generate-changelog"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "skills": {
    "skill-socrates": {
      "description": "苏格拉底式提问 - 需求确认时触发",
      "trigger": {
        "type": "pattern",
        "pattern": "F[0-9]{3}.*(已确认|合并到主干)",
        "auto_run": true
      },
      "config": {
        "min_questions": 3,
        "max_questions": 5,
        "categories": [
          "technical",
          "risk",
          "alignment",
          "edge-case",
          "maintenance"
        ]
      },
      "tools": ["AskUserQuestion", "Read", "Grep"],
      "forbidden_tools": ["Edit", "Write", "Bash", "Agent", "Skill"]
    },
    "skill-req-review": {
      "description": "需求文档审查 - 检查REQ ID唯一性、状态流程等",
      "trigger": {
        "type": "git_hook",
        "event": "pre-commit",
        "files": [
          "product-truth/REQ_REGISTRY.yml",
          "product-truth/00-master/PROJECT-主文档.md"
        ]
      },
      "tools": ["Read", "Grep", "Glob"],
      "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash", "Agent", "Skill"],
      "checks": ["R1", "R2", "R3", "R4", "R5"]
    },
    "skill-code-review": {
      "description": "代码审查 - 检查REQ标记、TODO、错误处理等",
      "trigger": {
        "type": "git_hook",
        "event": "pre-commit",
        "files": [
          "product-truth/product-code/**/*.ts",
          "product-truth/product-code/**/*.tsx"
        ]
      },
      "tools": ["Read", "Grep"],
      "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash", "Agent", "Skill"],
      "checks": ["C1", "C2", "C3", "C4"]
    },
    "skill-security-audit": {
      "description": "安全审计 - 扫描密钥泄露、SQL注入、XSS等",
      "trigger": {
        "type": "git_hook",
        "event": "pre-commit",
        "files": [
          "product-truth/product-code/**/*"
        ]
      },
      "manual_command": "/skill-security-audit",
      "tools": ["Read", "Grep", "Glob"],
      "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash"],
      "checks": ["S1", "S2", "S3", "S4", "S5"]
    },
    "skill-doc-sync": {
      "description": "文档同步检查 - 确保代码与文档同步",
      "trigger": {
        "type": "git_hook",
        "event": "pre-commit"
      },
      "tools": ["Read", "Grep", "Glob"],
      "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash"],
      "checks": ["D1", "D2", "D3"]
    },
    "skill-commit-msg": {
      "description": "提交信息规范检查",
      "trigger": {
        "type": "git_hook",
        "event": "commit-msg"
      },
      "tools": ["Read"],
      "forbidden_tools": ["Edit", "Write", "AskUserQuestion", "Bash", "Agent", "Skill"],
      "pattern": "^(feat|fix|docs|style|refactor|test|chore)(\\(.+\\))?: .+"
    }
  },
  "gates": {
    "G2": {
      "description": "审查门 - 只读工具",
      "tools": [
        "Read",
        "Grep",
        "Glob"
      ],
      "skills": [
        "skill-req-review",
        "skill-code-review"
      ]
    },
    "G4": {
      "description": "复核门 - 只读工具",
      "tools": [
        "Read",
        "Grep"
      ],
      "skills": [
        "skill-socrates"
      ]
    }
  }
}
