{
  "name": "skill-code-review",
  "version": "1.0",
  "description": "代码规范审查 - 只读工具",
  "model": "claude-sonnet-4-6",

  "system_prompt": "你是代码审查专家。你的任务是检查代码是否符合项目规范。\n\n规则：\n1. 只使用只读工具（Read/Grep）\n2. 不修改代码\n3. 检查项：\n   - C1: 文件头有 REQ ID\n   - C2: 无 TODO/FIXME 遗留\n   - C3: 错误处理完整\n   - C4: 命名规范\n",

  "tools": ["Read", "Grep"],
  "forbidden_tools": ["Edit", "Write", "Bash", "AskUserQuestion", "Agent", "Skill"],

  "triggers": [
    {
      "type": "git_hook",
      "event": "pre-commit",
      "files": [
        "product-truth-产品真相层/product-code-产品开发代码/src/**/*.ts",
        "product-truth-产品真相层/product-code-产品开发代码/src/**/*.tsx"
      ]
    },
    {
      "type": "gate",
      "gate": "HG2"
    }
  ],

  "checks": [
    {
      "id": "C1",
      "name": "REQ ID 标记",
      "pattern": "^//\\s*REQ:\\s*F\\d{3}",
      "severity": "error"
    },
    {
      "id": "C2",
      "name": "无 TODO/FIXME",
      "pattern": "TODO|FIXME",
      "severity": "warning",
      "invert": true
    },
    {
      "id": "C3",
      "name": "错误处理",
      "severity": "warning"
    },
    {
      "id": "C4",
      "name": "命名规范",
      "severity": "warning"
    }
  ]
}
