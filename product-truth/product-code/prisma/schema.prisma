// L2 Truth: Database Schema
// REQ_REGISTRY: F003, F005, F001
// FREEZE-SPEC: DB Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════
// Account & Identity (REQ: F003)
// ═══════════════════════════════════════════════════════════════

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  phone         String?  @unique
  display_name  String?
  password_hash String
  status        String   @default("active") // active, disabled
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Relations
  quotes              Quote[]
  contracts           Contract[]
  tokens              AuthToken[]
  requested_approvals ApprovalRequest[] @relation("ApprovalRequester")
  assigned_approvals  ApprovalRequest[] @relation("ApprovalApprover")

  @@index([email])
  @@index([phone])
  @@map("users")
}

model AuthToken {
  id         String    @id @default(uuid())
  token      String    @unique
  user_id    String
  expires_at DateTime?
  created_at DateTime  @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([user_id])
  @@map("auth_tokens")
}

// ═══════════════════════════════════════════════════════════════
// Quote Center (REQ: F001, F002)
// ═══════════════════════════════════════════════════════════════

model Quote {
  id               String    @id @default(uuid())
  quote_no         String    @unique
  version          Int       @default(1)
  parent_id        String?
  customer_name    String
  customer_contact String?
  subtotal         Decimal   @default(0) @db.Decimal(15, 2)
  discount_amount  Decimal   @default(0) @db.Decimal(15, 2)
  tax_amount       Decimal   @default(0) @db.Decimal(15, 2)
  total_amount     Decimal   @default(0) @db.Decimal(15, 2)
  valid_until      DateTime?
  status           String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, CONFIRMED, REJECTED
  created_by       String
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Relations
  creator User        @relation(fields: [created_by], references: [id])
  items   QuoteItem[]

  @@index([quote_no])
  @@index([status])
  @@index([created_by])
  @@index([created_at])
  @@map("quotes")
}

model QuoteItem {
  id           String  @id @default(uuid())
  quote_id     String
  product_name String
  description  String?
  quantity     Decimal @db.Decimal(10, 2)
  unit_price   Decimal @db.Decimal(15, 2)
  discount     Decimal @default(0) @db.Decimal(5, 2)
  subtotal     Decimal @db.Decimal(15, 2)
  tax_rate     Decimal @default(0) @db.Decimal(5, 2)
  tax_amount   Decimal @default(0) @db.Decimal(15, 2)
  total        Decimal @db.Decimal(15, 2)
  sort_order   Int     @default(0)

  // Relations
  quote Quote @relation(fields: [quote_id], references: [id], onDelete: Cascade)

  @@index([quote_id])
  @@map("quote_items")
}

// ═══════════════════════════════════════════════════════════════
// Contract Review (REQ: F005)
// ═══════════════════════════════════════════════════════════════

model Contract {
  id           String   @id @default(uuid())
  filename     String
  storage_path String
  size         Int
  mime_type    String
  status       String   @default("PENDING") // PENDING, PARSING, ANALYZING, COMPLETED, FAILED
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  creator User             @relation(fields: [created_by], references: [id])
  reviews ContractReview[]

  @@index([status])
  @@index([created_by])
  @@map("contracts")
}

model ContractReview {
  id            String    @id @default(uuid())
  contract_id   String
  status        String    @default("PARSING") // PARSING, ANALYZING, COMPLETED, FAILED
  results       Json? // AI analysis results
  error_message String?
  started_at    DateTime  @default(now())
  completed_at  DateTime?

  // Relations
  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)

  @@index([contract_id])
  @@index([status])
  @@map("contract_reviews")
}

// ═══════════════════════════════════════════════════════════════
// Approval Workflow (REQ: F004)
// ═══════════════════════════════════════════════════════════════

model ApprovalRequest {
  id           String   @id @default(uuid())
  object_type  String // quote, contract
  object_id    String
  requester_id String
  approver_id  String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED, TRANSFERRED, TIMEOUT
  comment      String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  requester User           @relation("ApprovalRequester", fields: [requester_id], references: [id])
  approver  User?          @relation("ApprovalApprover", fields: [approver_id], references: [id])
  steps     ApprovalStep[]

  @@index([object_id])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalStep {
  id              String   @id @default(uuid())
  approval_id     String
  approver_id     String
  action          String // approve, reject, transfer
  comment         String?
  previous_status String
  new_status      String
  created_at      DateTime @default(now())

  // Relations
  approval ApprovalRequest @relation(fields: [approval_id], references: [id], onDelete: Cascade)

  @@index([approval_id])
  @@map("approval_steps")
}

// ═══════════════════════════════════════════════════════════════
// Rule Configuration (REQ: F006, F009)
// ═══════════════════════════════════════════════════════════════

model RuleConfig {
  id         String   @id @default(uuid())
  code       String   @unique // R1.1, R1.2, etc
  name       String
  category   String // payment, liability, ip, etc
  rule_type  String // structured, semantic
  content    Json // YAML content as JSON
  severity   String // red, yellow, green
  is_active  Boolean  @default(true)
  version    Int      @default(1)
  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([code])
  @@index([category])
  @@index([is_active])
  @@map("rule_configs")
}

// ═══════════════════════════════════════════════════════════════
// Audit & Events
// ═══════════════════════════════════════════════════════════════

model AuditLog {
  id          String   @id @default(uuid())
  actor_id    String?
  action      String // create, update, delete, login
  target_type String // quote, contract, user
  target_id   String?
  diff        Json? // changed fields
  metadata    Json? // request_id, ip, user_agent
  created_at  DateTime @default(now())

  @@index([actor_id])
  @@index([target_type, target_id])
  @@index([created_at])
  @@map("audit_logs")
}
