# Cyanlog Sales Platform - 环境变量模板
# 复制此文件为 .env.local 并填写实际值
# ⚠️ 切勿将包含真实密钥的 .env.local 提交到 Git

# ============================================
# Supabase 配置（必须）
# 从 Supabase Dashboard > Project Settings > API 获取
# ⚠️ SpaceX级安全要求：切勿硬编码，必须使用环境变量
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 客户端匿名密钥（公开，用于浏览器端）
# 获取位置：Supabase Console → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端管理员密钥（机密，仅用于服务器/脚本）
# 获取位置：Supabase Console → Project Settings → API → service_role secret
# 使用场景：scripts/seed-relations.mjs, scripts/verify.mjs, 数据迁移脚本
# 🔴 安全警告：此密钥拥有数据库完全访问权限，泄露=全站暴露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Sentry 错误监控（可选但推荐）
# 从 https://sentry.io 创建项目后获取 DSN
# ============================================
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# ============================================
# 数据库配置（Prisma必需）
# ============================================
# 连接字符串格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# 对于Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/cyanlog
DIRECT_URL=postgresql://postgres:password@localhost:5432/cyanlog

# ============================================
# 认证配置（必须）
# 生成密钥: openssl rand -base64 32
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-string-min-32-chars
JWT_SECRET=change-this-to-another-random-string-min-32-chars

# ============================================
# AI 模型配置（本地开发必需）
# ============================================
LOCAL_MODEL_URL=http://127.0.0.1:1234/v1
LOCAL_MODEL_NAME=gpt-oss-20b
# LM Studio 开启 Require authentication 时必须填写；关闭认证时可留空。
LOCAL_MODEL_API_KEY=

# 云端备用 / 生产模型网关（OpenAI-compatible）
AI_GATEWAY_URL=https://cloud.yiyongai.cn/v1
AI_GATEWAY_API_KEY=your-openai-compatible-api-key
AI_MODEL=your-cloud-model-id

# 模型路由阈值
LOCAL_MAX_PAGES=15
LOCAL_MAX_PAGES_WITH_FALLBACK=40
LOCAL_TIMEOUT_MS=45000

# ============================================
# 功能开关
# ============================================
ENABLE_SEMANTIC_RULES=true
ENABLE_WORD_ANNOTATION=false
ENABLE_CLOUD_FALLBACK=true

# ============================================
# 飞书组织同步（启用时三项均必填）
# FEISHU_ORG_ID 必须是此飞书租户被允许写入的 ONES 组织 ID
# ============================================
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_ORG_ID=your-ones-organization-id

# ============================================
# 开发调试
# ============================================
LOG_LEVEL=debug
NEXT_PUBLIC_REACT_QUERY_DEVTOOLS=true

# F054 - server-only shipping settings; leave disabled until configured privately
SHIPPING_ALLOWED_USER_IDS=
SF_ENVIRONMENT=sandbox
SF_PARTNER_ID=
SF_CHECK_WORD=
SF_MONTHLY_CARD=
# Sandbox uses the SF-provided test card, never the real monthly account
SF_SANDBOX_MONTHLY_CARD=
SF_SERVICES_JSON=[]
SHIPPING_SENDER_JSON={}
# 生产月结下单不接受环境变量直接解锁；需先实现并验证付款者逐单审核合同。
