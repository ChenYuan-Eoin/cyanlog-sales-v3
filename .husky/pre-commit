#!/bin/bash
# Pre-commit hook for governance
# REQ: F003-F007

set -e

echo "🔍 Running pre-commit checks..."

# Check 1: TypeScript compilation
echo "📦 Type checking..."
cd /Users/nsss/Price-v3/cyanlog-sales-v3
pnpm tsc --noEmit

# Check 2: Lint
echo "🧹 Linting..."
pnpm lint

# Check 3: REQ标记检查
echo "🏷️  Checking governance tags..."

# 检查API文件是否有REQ标记
for file in app/api/*/route.ts app/api/*/*/route.ts; do
  if [ -f "$file" ] && [ -s "$file" ]; then
    if ! grep -q "REQ:" "$file"; then
      echo "❌ Missing REQ tag in $file"
      exit 1
    fi
  fi
done

echo "✅ All checks passed!"
