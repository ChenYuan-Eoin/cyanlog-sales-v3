#!/bin/bash
# post-commit - 提交后自动触发 Skills
# ONES 模式：监听 REQ 状态变更自动触发 socrates

set +e  # 错误不阻断

GIT_ROOT="$(git rev-parse --show-toplevel)"
cd "$GIT_ROOT"

# 把刚创建的 commit 绑定到同一 index tree 的 pre-commit 证据。
# post-commit 不阻断已完成的提交；记录失败会明确告警，交付门禁随后会拒绝
# 缺少 aiBehavior.checked=true 的提交，不能把静默失败冒充为已验证。
AUDIT_SCRIPT="$GIT_ROOT/governance/ai-behavior-准则/audit/log-commit.mjs"
if [ -f "$AUDIT_SCRIPT" ]; then
    node "$AUDIT_SCRIPT" HEAD || echo "⚠️  post-commit 审计记录失败；当前提交不能进入 code_green"
else
    echo "⚠️  post-commit 审计脚本缺失；当前提交不能进入 code_green"
fi

# 检查是否是 REQ 变更
if git diff --name-only HEAD~1 HEAD | grep -q "REQ_REGISTRY.yml"; then
    echo ""
    echo "📋 检测到 REQ_REGISTRY.yml 变更，执行 skill-socrates..."

    # 检查是否有状态变更
    STATUSES=$(git diff HEAD~1 HEAD product-truth/REQ_REGISTRY.yml | grep -E '^\+.*status:' | grep -oE '(confirmed|design_confirmed|completed)')

    if [ -n "$STATUSES" ]; then
        echo ""
        echo "🎯 检测到需求状态变更: $STATUSES"
        echo ""

        # 运行 socrates
        if [ -f "$GIT_ROOT/skill" ]; then
            "$GIT_ROOT/skill" socrates
        fi
    fi
fi

exit 0
