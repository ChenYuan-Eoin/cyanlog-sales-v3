#!/bin/bash
# Post-commit hook: 自动推送当前分支到远端
# 解决"本地修复后忘记推送，导致 Vercel 构建旧代码"的问题

# 获取当前分支名
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)

if [ -z "$CURRENT_BRANCH" ]; then
    echo "⚠️  无法获取当前分支名，跳过自动推送"
    exit 0
fi

# 检查是否有远端分支
if ! git rev-parse --abbrev-ref --symbolic-full-name @{u} > /dev/null 2>&1; then
    # 没有 upstream，尝试自动设置
    echo "🔄 首次推送分支 $CURRENT_BRANCH 到 origin..."
    if git push -u origin "$CURRENT_BRANCH" 2>&1; then
        echo "✅ 已推送并设置 upstream: origin/$CURRENT_BRANCH"
    else
        echo "⚠️  推送失败，请检查远程仓库配置"
    fi
    exit 0
fi

# 有 upstream，直接推送
echo "🔄 自动推送 $CURRENT_BRANCH 到 origin..."
if git push origin "$CURRENT_BRANCH" 2>&1; then
    echo "✅ 已推送: $CURRENT_BRANCH → origin/$CURRENT_BRANCH"
else
    echo "⚠️  推送失败，可能是网络问题或权限不足"
fi
